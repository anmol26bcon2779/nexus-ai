# NEXUS AI — Environment Configuration

# ----------------------------------------------------
# Supabase Configuration (Client & Backend)
# Obtain these from your Supabase Project Settings > API
# ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Server-Side Service Role Key (Used only in secure backend/edge functions)
# NEVER expose this key in frontend variables or git commits
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------
# Optional Server-Side AI Provider Keys
# ----------------------------------------------------
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local Backend Port (Default: 3001)
PORT=3001
